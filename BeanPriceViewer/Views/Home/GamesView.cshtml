*@
@{
    ViewData["Title"] = "Saved Cities";
    var Games = ViewBag.Games;
}

@model List<GameData>

<div class="text-center">
    <h1 class="display-4">Saved Games</h1>
    <a asp-action="NewGame" class="btn btn-primary mt-4">New Game</a>
    <br />
    <table class="table mt-4">
        <thead>
            <tr>
                <th>
                    Id
                </th>
                <th>
                    Turn
                </th>
                <th>
                    Max Turns
                </th>
                <th>
                    Cash
                </th>
                <th>
                    Blue Beans
                </th>
                <th>
                    Red Beans
                </th>
                <th>
                    Green Beans
                </th>
                <th>
                    Yellow Beans
                </th>
                <th>
                    Actions
                </th>
                <th>
                    
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach ( var game in Model)
                {
                    <tr>
                        <td>
                            @game.Id
                        </td>
                        <td>
                            @game.Turn
                        </td>
                        <td>
                            @game.MaxTurns
                        </td>
                        <td>
                            $@game.Cash
                        </td>
                        <td>
                            @game.BlueStock
                        </td>
                        <td>
                            @game.RedStock
                        </td>
                        <td>
                            @game.GreenStock
                        </td>
                        <td>
                            @game.YellowStock
                        </td>
                        <td>
                            <form asp-action="PlayGame" asp-controller="Home" asp-route-id="@game.Id">
                                <button class="btn btn-primary" type="submit">Play</button>
                            </form>
                        </td>
                        <td>
                            <form asp-action="DeleteGame" asp-controller="Home" asp-route-id="@game.Id">
                                <button class="btn btn-primary" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
