@{
    ViewData["Title"] = "Create / Edit";
    var cid = ViewBag.CID;
    var gameid = ViewBag.GameId;
}

@model GameData

<div class="text-center">
    <h1 class="display-4">Buying Beans: </h1>
</div>

<form asp-action="Purchase" asp-controller="Home" asp-route-cid="@cid" asp-route-gameid="@gameid">
    <input class="form-control" type="number" placeholder="Amount" asp-route="amount"/>
    <select class="form-control" type="text" asp-route="type">
        <option value="Blue">Blue beans</option>
        <option value="Red">Red beans</option>
        <option value="Green">Green beans</option>
        <option value="Yellow">Yellow beans</option> 
    </select>

    <button class="btn btn-primary mt-4" type="submit">Ok</button>
</form>