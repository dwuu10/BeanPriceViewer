@{
    ViewData["Title"] = "Create / Edit";
}

@model CalculationData

<div class="text-center">
    <h1 class="display-4">Buying Beans: </h1>
</div>

<form asp-action="Purchase" asp-controller="Home">
    <input hidden class="form-control" type="number" placeholder="0" asp-for="Id" />
    <input hidden class="form-control" type="number" placeholder="0" asp-for="CityId" />
    <input hidden class="form-control" type="number" placeholder="0" asp-for="Cash" />
    <input hidden class="form-control" type="number" placeholder="0" asp-for="Turn" />
    <input hidden class="form-control" type="number" placeholder="0" asp-for="MaxTurns" />
    <input hidden class="form-control" type="number" placeholder="0" asp-for="BlueStock" />
    <input hidden class="form-control" type="number" placeholder="0" asp-for="RedStock" />
    <input hidden class="form-control" type="number" placeholder="0" asp-for="GreenStock" />
    <input hidden class="form-control" type="number" placeholder="0" asp-for="YellowStock" />
    <input class="form-control" type="number" placeholder="Amount" asp-for="amount" />
    <select class="form-control" type="text" asp-for="BeanType">
        <option value="Blue">Blue beans</option>
        <option value="Red">Red beans</option>
        <option value="Green">Green beans</option>
        <option value="Yellow">Yellow beans</option> 
    </select>

    <button class="btn btn-primary mt-4" type="submit">Ok</button>
</form>