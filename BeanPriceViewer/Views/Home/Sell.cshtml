@{
    ViewData["Title"] = "Create / Edit";
    var cid = ViewBag.CID;
    var gameid = ViewBag.GameId;
    var amount = ViewBag.Amount;
    var type = ViewBag.Type;
    var bean = ViewBag.BeanString;
    var cost = ViewBag.Cost;
}

<div class="text-center">
    <h1 class="display-4">Confirm Sale?</h1>
    <p>Bean Type: @bean</p>
    <p>Amount: @amount</p>
    <p>Value: $@cost</p>

    <form asp-action="ConfirmSale" asp-controller="Home" asp-route-cid="@cid" asp-route-gameid="@gameid" asp-route-amount="@amount" asp-route-type="@type">
        <button class="btn btn-primary" type="submit">Confirm Purchase</button>
    </form>
</div>

