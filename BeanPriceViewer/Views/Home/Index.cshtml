@{
    ViewData["Title"] = "Home Page";
}

@model City

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Find a city of your choice and view the current bean prices</p>
    <form asp-action="SeeCity" asp-controller="Home">
        <input hidden class="form-control" type="number" placeholder="0" asp-for="Id" />
        <input class="form-control mt-4" type="text" placeholder="City name here" asp-for="Name" />
        <button class="btn btn-primary mt-4" type="submit">Find City</button>
    </form>
    <img class="mt-4" src="~/images/test_bean.png" />
</div>
