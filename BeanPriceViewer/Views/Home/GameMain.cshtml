    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Saved Cities";
    var cities = ViewBag.Cities;
}

@model GameData

<div class="text-center">
    <h1 class="display-4">Saved Cities</h1>
    <p>Cash: @Model.Cash</p>
    <p>Turns: @Model.Turn / @Model.MaxTurns</p>
    <form asp-action="NextTurn" asp-controller="Home">
        <input hidden class="form-control" type="number" placeholder="@Model.Id" asp-for="Id" />
        <input hidden class="form-control" type="number" placeholder="@Model.Cash" asp-for="Cash" />
        <input hidden class="form-control" type="number" placeholder="@Model.Turn" asp-for="Turn" />
        <input hidden class="form-control" type="number" placeholder="@Model.MaxTurns" asp-for="MaxTurns" />
        <input hidden class="form-control" type="number" placeholder="@Model.BlueStock" asp-for="BlueStock" />
        <input hidden class="form-control" type="number" placeholder="@Model.RedStock" asp-for="RedStock" />
        <input hidden class="form-control" type="number" placeholder="@Model.GreenStock" asp-for="GreenStock" />
        <input hidden class="form-control" type="number" placeholder="@Model.YellowStock" asp-for="YellowStock" />

        <button class="btn btn-primary" type="submit">Skip turn</button>
    </form>
    <br />
    <table class="table mt-4">
        <thead>
            <tr>
                <th>
                    Id
                </th>
                <th>
                    City
                </th>
                <th>
                    Temperature (Fahrenheit)
                </th>
                <th>
                    Humidity
                </th>
                <th>
                    Blue Bean Price
                </th>
                <th>
                    Red Bean Price
                </th>
                <th>
                    Green Bean Price
                </th>
                <th>
                    Yellow Bean Price
                </th>
                <th>
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                foreach ( var city in cities)
                {
                    <tr>
                        <td>
                            @city.Id
                        </td>
                        <td>
                            @city.Name
                        </td>
                        <td>
                            @city.Temperature
                        </td>
                        <td>
                            @city.Humidity
                        </td>
                        <td>
                            @city.BluePrice
                        </td>
                        <td>
                            @city.RedPrice
                        </td>
                        <td>
                            @city.GreenPrice
                        </td>
                        <td>
                            @city.YellowPrice
                        </td>
                        <td>
                            <a asp-action="BuyMenu" asp-route-cid="@city.Id" asp-route-gameid="@Model.Id">Buy</a>
                        </td>
                        <td>
                            <a asp-action="SellMenu" asp-route-cid="@city.Id" asp-route-gameid="@Model.Id">Sell</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
