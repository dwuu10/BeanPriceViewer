@{
    ViewData["Title"] = "Create / Edit";
    var id = ViewBag.Id;
}

@model GameData

<div class="text-center">
    <h1 class="display-4">Something went wrong</h1>
    <p>Check if the transaction is valid and try again</p>

    <form asp-action="PlayGame" asp-controller="Home" asp-route-id="@id">
        <button class="btn btn-primary mt-4" type="submit">Ok</button>
    </form>
</div>
